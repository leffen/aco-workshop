# Your settings for the workshop. make setup copies this file to .env, which is
# git-ignored: never commit it. Every make target reads .env.
# One KEY=value per line.

# The model behind the agent.
#   anthropic  Claude, through your API key. The tested path, and fine on 8 GB.
#   ollama     A local model. Needs Ollama and 16 GB or more; see agents/ladder/.
ACO_BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# For ACO_BACKEND=ollama only. Pick a pinned model from agents/modes.py.
# ACO_OLLAMA_MODEL=aco-qwen3-4b-24k:latest
# ACO_OLLAMA_URL=http://localhost:11434
